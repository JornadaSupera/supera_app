# Copie para .env e preencha com as credenciais do projeto Supabase.
#
# Use SEMPRE a chave publicável (anon/publishable).
#
# ⚠️ Tudo que começar com SUPABASE_ neste arquivo é embutido no pacote do
# cliente e fica legível para qualquer pessoa que abra o app (é o `envPrefix`
# do vite.config.ts que faz isso). A chave `service_role` ignora a RLS e
# JAMAIS pode entrar aqui — nem com outro nome.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
