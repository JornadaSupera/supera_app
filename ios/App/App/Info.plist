				     GoogleService-Info.plist do Firebase, que este projeto não
				     tem — ela resolveria vazia e o retorno do Google se perderia. -->
				<string>com.googleusercontent.apps.934966976020-mdsiqpb75g3pki1vfpgmcphq09iofnou</string>
			</array>
		</dict>
	</array>
