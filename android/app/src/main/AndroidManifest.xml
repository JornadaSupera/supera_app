<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- `requestLegacyExternalStorage` vale para o Android 10 (API 29) e só
         para ele: sem o atributo, gravar a orientação em PDF na pasta pública
         de documentos é bloqueado pelo armazenamento por escopo. Da API 30 em
         diante o sistema ignora o atributo, e o app já pode gravar os
         arquivos que ele próprio criou.

         Sem backup: apagar o app apaga o acesso. Com o backup ligado, o
         Android guardava os dados do app no Google Drive e os devolvia numa
         reinstalação ou num aparelho novo. `allowBackup="false"` desliga o
         backup em nuvem; a partir do Android 12, alguns fabricantes ainda
         copiam os dados de aparelho para aparelho, e é
         `data_extraction_rules.xml` que fecha essa porta também. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Cor de destaque das notificações do OneSignal (formato ARGB): o
             verde da capa da marca, o mesmo token color-brand-cover do app. É
             ela que tinge o "S" do ícone pequeno (drawable/ic_stat_onesignal_default)
             no cabeçalho do aviso. -->
        <meta-data
            android:name="com.onesignal.NotificationAccentColor.DEFAULT"
            android:value="FF0E7F80" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!-- Acesso à rede: o app inteiro lê e grava no Supabase, e o chat mantém
         uma conexão de tempo real. Sem isto o WebView não sai do lugar. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Estado da conexão: permite distinguir "sem internet" de "servidor
         fora do ar" e evitar disparar requisição offline. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Notificações: obrigatória a partir do Android 13 (API 33). O
         targetSdk é 36, então sem esta permissão o pedido de autorização do
         OneSignal falha silenciosamente e nenhum aviso chega ao aparelho. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Armazenamento: a orientação em PDF é gravada na pasta pública de
         documentos, para o paciente relê-la offline por qualquer gerenciador
         de arquivos. O minSdk é 24, e até o Android 10 (API 29) escrever ali
         exige estas duas permissões — o plugin de arquivos as pede em tempo
         de execução, mas o pedido é negado na hora se elas não estiverem
         declaradas aqui.

         Os `maxSdkVersion` são o que mantém o app fora da política de acesso
         a todos os arquivos: a partir do Android 11 (API 30) a escrita do
         próprio app dispensa permissão, e a leitura deixa de ser necessária
         no Android 13 (API 33). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
</manifest>
